def clean_sex_column(series):
    normalized = series.astype(str).str.strip().str.upper()

    mapping = {
        'M': 'Male',
        'MALE': 'Male',
        'F': 'Female',
        'FEMALE': 'Female'
    }
    return normalized.map(mapping)

df['sex_clean'] = clean_sex_column(df['sex'])
print("Cleaned Sex Categories:")
print(df['sex_clean'].value_counts())
